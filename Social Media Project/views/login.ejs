<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width , initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/stylesheets/style.css">
  </head>
  <body class="bg-zinc-900">
<div class="main w-full min-h-screen p-3">
  <h2 class="text-white text-3xl">Login Account</h2> 
  <div class="w-full h-full bg-zinc-900 text-white p-10">
    <form method="post" action="/login">
      <input class="px-3 py-2 rounded-md bg-transparent border-2 border-zinc-800 outline-none"  placeholder="email" type="text" name="email">
      <input class="px-3 py-2 rounded-md bg-transparent border-2 border-zinc-800 outline-none"  placeholder="password" type="password" name="password">
      <input class="px-5 py-2 rounded-md bg-blue-500" value="login" type="submit" >
    </form>
<script src="/javascripts/script.js"></script>
  </body>
</html>