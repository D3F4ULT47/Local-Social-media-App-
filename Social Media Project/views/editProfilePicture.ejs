<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width , initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/stylesheets/style.css">
  </head>
  <body class="bg-zinc-900">
<div class="main w-full min-h-screen p-3">
  <h2 class="text-white text-3xl">Edit Profile Picture</h2> 
  <div class="w-full h-full bg-zinc-900 text-white p-10">
    <form method="post" action="/editProfilePicture/<%=user._id%>" enctype="multipart/form-data" >
      <input class="px-3 py-2 rounded-md bg-transparent  outline-none"  placeholder="profileImage" type="file" name="image">
      <input class="px-5 py-2 rounded-md bg-blue-500" value="Upload Image" type="submit" >
    </form>
<script src="/javascripts/script.js"></script>
  </body>
</html>